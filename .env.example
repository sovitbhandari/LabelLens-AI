# Application
APP_ENV=development
APP_NAME=LabelLens AI
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Development auth for administrative endpoints
# Send header: X-Admin-Token: <value>
ADMIN_TOKEN=dev-admin-token-change-me

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=labellens
POSTGRES_PASSWORD=labellens
POSTGRES_DB=labellens
DATABASE_URL=postgresql+psycopg://labellens:labellens@localhost:5432/labellens
TEST_DATABASE_URL=postgresql+psycopg://labellens:labellens@localhost:5432/labellens_test

# DailyMed
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
DAILYMED_DOWNLOAD_BASE_URL=https://dailymed.nlm.nih.gov/dailymed
DAILYMED_TIMEOUT_SECONDS=60
DAILYMED_MAX_RETRIES=5
DAILYMED_RATE_LIMIT_RPS=2

# Embeddings (local Sentence Transformers by default)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Optional OpenAI embeddings alternative:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
RETRIEVAL_TOP_K=5
RRF_K=60

# Generation (OpenAI)
# Generation: auto | openai | gemini (auto prefers Gemini when set)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
GENERATION_TEMPERATURE=0.0

# MLflow
# Local file store by default. For server mode: http://localhost:5001
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=labellens-rag
MLFLOW_REGISTERED_MODEL_NAME=labellens-rag-pipeline

# Pipeline identity
PIPELINE_VERSION=0.1.0
PROMPT_TEMPLATE_VERSION=v1
